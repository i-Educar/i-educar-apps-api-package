{
    "name": "buriti/i-educar-apps-api-package",
    "description": "API Apps pais/professores (TR 5.13+5.14) para o i-Educar 2.12.",
    "version": "0.1.0",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "keywords": ["ieducar", "buriti", "laguna"],
    "authors": [{"name": "Buriti"}],
    "require": {
        "php": ">=8.3",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "iEducar\\Packages\\BuritiAppsApi\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "iEducar\\Packages\\BuritiAppsApi\\Providers\\AppsApiServiceProvider"
            ]
        },
        "ieducar": {
            "compatible": ["2.12"]
        }
    },
    "config": {
        "sort-packages": true
    }
}
